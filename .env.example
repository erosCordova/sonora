DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
APP_SECRET=            # openssl rand -hex 32  (firma las URLs temporales de audio)
WORKER_TOKEN=          # openssl rand -hex 32  (autentica al worker de IA)
STORAGE_DIR=./storage  # volumen persistente para los audios
APP_URL=http://localhost:3000
COOKIE_SECURE=false    # true detrás de HTTPS
# Recuperación de contraseña por correo (opcional)
# SMTP_URL=smtp://usuario:clave@smtp.ejemplo.com:587
# MAIL_FROM="Sonora <no-reply@ejemplo.com>"
# Letras con LLM abierto (cualquier endpoint compatible con OpenAI, p. ej. Ollama)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# Límites
# MAX_ACTIVE_JOBS=4
# MAX_JOBS_PER_DAY=40
