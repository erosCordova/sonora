SONORA_API_URL=http://127.0.0.1:3000
WORKER_TOKEN=el-mismo-valor-que-en-el-servidor
MUSIC_ENGINE=acestep
ACESTEP_DIR=/ruta/a/ACE-Step-1.5
# acestep-v15-turbo (rápido, 8 pasos) | acestep-v15-sft | acestep-v15-base
ACESTEP_DIT=acestep-v15-turbo
# acestep-5Hz-lm-0.6B | acestep-5Hz-lm-1.7B | none (ahorra VRAM; sin composición automática de letras)
ACESTEP_LM_MODEL=acestep-5Hz-lm-1.7B
ACESTEP_LM_BACKEND=pt
ACESTEP_DEVICE=auto
ACESTEP_OFFLOAD=false
# none | int8_weight_only
ACESTEP_QUANTIZATION=none
WORKER_AUDIO_FORMAT=mp3
